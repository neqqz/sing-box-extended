{
  "inbounds": [
    {
      "type": "trusttunnel",
      "tag": "trusttunnel-in",
      "listen": "::",
      "listen_port": 443,
      "network": ["tcp", "udp"],
      "users": [
        {
          "name": "user1",
          "password": "password1"
        }
      ],
      "congestion_controller": "bbr", // bbr, bbr_standard, bbr2, bbr2_variant, cubic, reno
      "cwnd": 32,
      // Паддинг размера пакетов/фреймов — packet_padding применяется к
      // QUIC-пакетам (udp/h3), data_padding — к h2 DATA-фреймам (tcp).
      // Значения ниже — стартовая точка, подбирайте под свой профиль
      // трафика. У PADDED-флага HTTP/2 однобайтовое поле длины (RFC 7540
      // §6.1), поэтому data_padding.max > 255 смысла не имеет.
      "packet_padding": { "min": 0, "max": 900 },
      "data_padding": { "min": 0, "max": 255 },
      // "timing": { "min_ms": 0, "max_ms": 40 } — джиттер задержки перед
      // каждой записью. Выключен по умолчанию (нет поля) — это прямой
      // trade-off с latency/пингом, раскомментируйте осознанно.
      "tls": {
        "enabled": true,
        "alpn": ["h2", "h3"],
        "certificate_path": "/path/to/cert.pem",
        "key_path": "/path/to/key.pem"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
